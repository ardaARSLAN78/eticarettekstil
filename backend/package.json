{
  "name": "@quantia/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/prepare-tests.mjs && vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "worker": "tsx --env-file=.env src/jobs/worker.ts"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.0.30",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cookie-parser": "1.4.7",
    "dotenv": "^17.2.3",
    "express": "5.3.0",
    "graphql": "^16.11.0",
    "graphql-type-json": "^0.3.2",
    "helmet": "8.3.0",
    "ioredis": "^5.8.2",
    "multer": "^2.5.0",
    "pg": "^8.16.3",
    "prisma": "7.10.1",
    "sharp": "^0.35.5",
    "stripe": "^20.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "vitest": "5.1.0"
  }
}
