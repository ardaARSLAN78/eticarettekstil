generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  DEMO
  REFUND_REQUIRED
}

enum SizeGroup {
  CLOTHING
  FOOTWEAR
  ACCESSORY
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum StockMovementReason {
  INITIAL
  ADJUSTMENT
  RESERVATION
  RELEASE
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  name           String
  passwordHash   String
  role           Role                 @default(CUSTOMER)
  disabled       Boolean              @default(false)
  createdAt      DateTime             @default(now())
  sessions       Session[]
  orders         Order[]
  auditLogs      AuditLog[]
  addresses      CustomerAddress[]
  stockMovements StockMovement[]
  statusHistory  OrderStatusHistory[]
  mediaAssets    MediaAsset[]
  cart           Cart?
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Category {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  image          String
  sortOrder      Int        @default(0)
  description    String     @default("")
  active         Boolean    @default(true)
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[] @relation("CategoryTree")
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  noIndex        Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  products       Product[]
  campaigns      Campaign[] @relation("CampaignCategories")

  @@index([parentId, active, sortOrder])
}

model Product {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  subtitle       String
  description    String
  material       String
  care           String
  price          Int
  compareAtPrice Int?
  media          ProductImage[]
  badge          String?
  active         Boolean        @default(true)
  featured       Boolean        @default(false)
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  variants       Variant[]
  brandId        String?
  brand          Brand?         @relation(fields: [brandId], references: [id])
  collections    Collection[]   @relation("ProductCollections")
  campaigns      Campaign[]     @relation("CampaignProducts")
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  ogImage        String?
  noIndex        Boolean        @default(false)
  vatRateBps     Int            @default(0)
  weightGrams    Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([active, featured, createdAt])
  @@index([categoryId, active])
}

model Variant {
  id                String          @id @default(cuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId           String
  colorInfo         Color           @relation(fields: [colorId], references: [id])
  sizeId            String
  sizeInfo          Size            @relation(fields: [sizeId], references: [id])
  sku               String          @unique
  barcode           String?         @unique
  price             Int?
  lowStockThreshold Int             @default(3)
  version           Int             @default(0)
  warehouseId       String          @default("main")
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id])
  stock             Int             @default(0)
  active            Boolean         @default(true)
  cartItems         CartItem[]
  movements         StockMovement[]

  @@unique([productId, colorId, sizeId])
  @@index([stock, active])
}

model Color {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  hex       String
  sortOrder Int            @default(0)
  variants  Variant[]
  images    ProductImage[]
}

model Size {
  id        String    @id @default(cuid())
  label     String
  code      String
  group     SizeGroup @default(CLOTHING)
  sortOrder Int       @default(0)
  variants  Variant[]

  @@unique([group, code])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int     @default(0)
  colorId   String?
  color     Color?  @relation(fields: [colorId], references: [id])

  @@index([productId, sortOrder])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  logo        String?
  products    Product[]
}

model Collection {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String    @default("")
  image          String
  active         Boolean   @default(true)
  sortOrder      Int       @default(0)
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  noIndex        Boolean   @default(false)
  products       Product[] @relation("ProductCollections")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Campaign {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  description     String               @default("")
  type            DiscountType
  value           Int
  active          Boolean              @default(false)
  automatic       Boolean              @default(false)
  startsAt        DateTime
  endsAt          DateTime
  minimumSubtotal Int                  @default(0)
  maximumDiscount Int?
  usageLimit      Int?
  perEmailLimit   Int?
  products        Product[]            @relation("CampaignProducts")
  categories      Category[]           @relation("CampaignCategories")
  coupons         Coupon[]
  redemptions     CampaignRedemption[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([active, automatic, startsAt, endsAt])
}

model Coupon {
  id          String               @id @default(cuid())
  code        String               @unique
  campaignId  String
  campaign    Campaign             @relation(fields: [campaignId], references: [id])
  active      Boolean              @default(true)
  usageLimit  Int?
  redemptions CampaignRedemption[]
}

model CampaignRedemption {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  couponId   String?
  coupon     Coupon?  @relation(fields: [couponId], references: [id])
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  emailHash  String
  amount     Int
  createdAt  DateTime @default(now())

  @@index([campaignId, emailHash])
}

model StockMovement {
  id          String              @id @default(cuid())
  variantId   String
  variant     Variant             @relation(fields: [variantId], references: [id])
  delta       Int
  reason      StockMovementReason
  warehouseId String              @default("main")
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  orderId     String?
  order       Order?              @relation(fields: [orderId], references: [id])
  actorId     String?
  actor       User?               @relation(fields: [actorId], references: [id])
  note        String?
  createdAt   DateTime            @default(now())

  @@index([variantId, createdAt])
}

model CustomerAddress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  fullName    String
  phone       String
  address     String
  city        String
  district    String
  postalCode  String
  countryCode String   @default("TR")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, isDefault])
}

model Cart {
  id         String     @id @default(cuid())
  tokenHash  String     @unique
  couponCode String?
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  version    Int        @default(0)
  items      CartItem[]
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  orders     Order[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int

  @@unique([cartId, variantId])
}

model Order {
  id                     String               @id @default(cuid())
  number                 String               @unique
  receiptTokenHash       String               @unique
  idempotencyKey         String
  cartId                 String
  cart                   Cart                 @relation(fields: [cartId], references: [id])
  userId                 String?
  user                   User?                @relation(fields: [userId], references: [id])
  email                  String
  customerName           String
  phone                  String
  address                String
  city                   String
  district               String
  postalCode             String
  subtotal               Int
  discountAmount         Int                  @default(0)
  taxAmount              Int                  @default(0)
  couponCode             String?
  shipping               Int
  total                  Int
  status                 OrderStatus          @default(PENDING_PAYMENT)
  paymentStatus          PaymentStatus        @default(PENDING)
  paymentProvider        String
  paymentSandbox         Boolean              @default(true)
  paymentConfigEncrypted String?
  buyerIdentityEncrypted String?
  paymentReference       String?
  paymentTokenHash       String?              @unique
  checkoutUrl            String?
  paymentExpiresAt       DateTime?
  stockReleased          Boolean              @default(false)
  trackingNumber         String?
  shippingCarrier        String?
  billingDetails         Json?
  invoiceNumber          String?
  invoiceUrl             String?
  items                  OrderItem[]
  paymentEvents          PaymentEvent[]
  campaignRedemption     CampaignRedemption?
  movements              StockMovement[]
  history                OrderStatusHistory[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@unique([cartId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, paymentExpiresAt])
}

model OrderItem {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  variantId      String
  name           String
  image          String
  color          String
  size           String
  sku            String
  unitPrice      Int
  discountAmount Int       @default(0)
  taxRateBps     Int       @default(0)
  taxAmount      Int       @default(0)
  quantity       Int
  warehouseId    String    @default("main")
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  note      String?
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id])
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  createdAt DateTime @default(now())
}

model MediaAsset {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String   @unique
  alt       String
  mimeType  String   @default("image/webp")
  bytes     Int
  width     Int
  height    Int
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PaymentConfig {
  provider  String   @id
  enabled   Boolean  @default(false)
  sandbox   Boolean  @default(true)
  encrypted String
  updatedAt DateTime @updatedAt
}

model IntegrationConfig {
  provider  String   @id
  enabled   Boolean  @default(false)
  encrypted String
  updatedAt DateTime @updatedAt
}

model PaymentEvent {
  id        String   @id @default(cuid())
  eventKey  String   @unique
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  consentAt      DateTime  @default(now())
  active         Boolean   @default(true)
  unsubscribedAt DateTime?
}

model Warehouse {
  id         String          @id @default(cuid())
  code       String          @unique
  name       String
  address    String          @default("")
  active     Boolean         @default(true)
  variants   Variant[]
  movements  StockMovement[]
  orderItems OrderItem[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  entityId  String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
